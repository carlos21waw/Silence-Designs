# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# DISCORD BOT & OAUTH2 CONFIGURATION
# Obtain these from https://discord.com/developers/applications
# ==============================================================================

# Discord Application Client ID (Public identifier)
DISCORD_CLIENT_ID="1025813762684502168"

# Discord Bot Token (Private bot secret token)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Discord OAuth2 Client Secret (Used for authenticating dashboard admins)
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"

# Discord OAuth2 Redirect URI (Must match the redirect URI in Discord Developer Portal)
DISCORD_REDIRECT_URI="http://localhost:3000/auth/callback"

# Target Server Guild ID (Optional default)
DISCORD_GUILD_ID="122849204859102401"

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/silencedesigns?schema=public"

# Optional Roblox Group Integration ID
ROBLOX_GROUP_ID="34552481"
